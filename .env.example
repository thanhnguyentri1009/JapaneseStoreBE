# App
PORT=3000
NODE_ENV=development

# Database
# Local Postgres (default):
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=japanese_store
DB_SSL=false

# Supabase (Dashboard -> Connect -> Session pooler):
# Use the Session pooler (not the direct "db.<ref>.supabase.co" host) —
# most hosting platforms (e.g. Render) don't support IPv6 outbound, and the
# direct host only resolves to an IPv6 address.
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<your Supabase DB password>
# DB_NAME=postgres
# DB_SSL=true

# Redis (cache)
# Local Redis (default):
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_SSL=false
# REDIS_PASSWORD=

# Upstash Redis (Console -> your database -> Details -> Connect):
# REDIS_HOST=pleasant-xxxx-12345.upstash.io   # host only, no "https://" prefix
# REDIS_PORT=6379
# REDIS_PASSWORD=<your Upstash token>
# REDIS_SSL=true

# Auth
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Mail (Resend — HTTP API, works even on hosts that block outbound SMTP ports)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=noreply@japanesestore.com
